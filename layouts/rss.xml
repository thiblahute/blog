{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} on {{ site.Title }}{{ end }}</title>
<link>{{ site.Home.Permalink }}</link>
<description>{{ site.Params.description }}</description>
<language>en</language>
<lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
{{ $pages := .Pages }}{{ if .IsHome }}{{ $pages = where site.RegularPages "Section" "posts" }}{{ end }}
{{ range first 30 $pages.ByDate.Reverse }}
<item>
<title>{{ .Title }}</title>
<link>{{ .Permalink }}</link>
<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
<guid isPermaLink="{{ if .Params.guid }}false{{ else }}true{{ end }}">{{ with .Params.guid }}{{ . }}{{ else }}{{ .Permalink }}{{ end }}</guid>
<description>{{ .Content | transform.XMLEscape | safeHTML }}</description>
</item>
{{ end }}
</channel>
</rss>
